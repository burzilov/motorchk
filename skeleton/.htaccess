# Запрет листинга директорий
Options -Indexes

# Закрыть служебные папки и файлы от прямого HTTP-доступа
<IfModule mod_authz_core.c>
    <Files ".env">
        Require all denied
    </Files>
</IfModule>

RedirectMatch 403 ^/content/
RedirectMatch 403 ^/config/
RedirectMatch 403 ^/cache/
RedirectMatch 403 ^/submissions/
# /core/: снаружи только /core/assets/ — правила в core/.htaccess, обновляются вместе с ядром
# Плагины: код и данные закрыты; статика — через /plugin-assets/{id}/... (index.php)
RedirectMatch 403 ^/plugins/
RedirectMatch 403 ^/plugin-data/

# Кеширование статики
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # motorchk:maintenance — блокировка статики при включённом режиме обслуживания.
    # Флаг-файл content/.maintenance создаёт и удаляет ядро (Maintenance::writeFlag).
    # /core/assets/ не блокируется: эти же файлы нужны панели администратора,
    # которая остаётся доступной в полном оформлении (docs/14-maintenance.md).
    # В существующих установках сниппет добавляется в корневой .htaccess вручную.
    RewriteCond %{DOCUMENT_ROOT}/content/.maintenance -f
    RewriteCond %{REQUEST_URI} ^/(themes/[^/]+/assets/|media/) [NC]
    RewriteRule ^ - [R=503,L]

    # Админка — front controller ядра
    RewriteRule ^admin-panel(/.*)?$ core/admin-panel/index.php [L,QSA]

    # motorchk:theme-assets
    RewriteCond %{REQUEST_URI} ^/themes/ [NC]
    RewriteCond %{REQUEST_URI} !^/themes/[^/]+/assets/ [NC]
    RewriteRule ^ - [F,L]

    # Существующие файлы и папки — отдать как есть (в т.ч. /core/assets/)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Всё остальное — публичный front controller
    RewriteRule ^ index.php [L,QSA]
</IfModule>
